<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>A_Reason_is_required_when_updating_a_Lea</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    NOT(ISCLONE()),
    ISPICKVAL(Status, &quot;Unqualified&quot;),
    ISBLANK(Reason__c)
)</errorConditionFormula>
    <errorDisplayField>Reason__c</errorDisplayField>
    <errorMessage>A Reason is required when updating a Lead status to Unqualified</errorMessage>
</ValidationRule>
